{
  "name": "oh-my-copilot-slim",
  "description": "Unofficial native GitHub Copilot adaptation of alvinunreal/oh-my-opencode-slim: an eight-role agent team (orchestrator, oracle, council, librarian, explorer, designer, fixer, observer) with per-role models, reasoning effort, MCP/skill policy, and a preset doctor.",
  "version": "0.3.0",
  "author": {
    "name": "nkhus",
    "url": "https://github.com/nkhus"
  },
  "homepage": "https://github.com/nkhus/oh-my-copilot-slim",
  "repository": "https://github.com/nkhus/oh-my-copilot-slim",
  "license": "MIT",
  "keywords": ["agents", "orchestrator", "subagents", "council", "oh-my-opencode-slim", "adaptation", "codegraph"],
  "category": "productivity",
  "agents": "agents/",
  "skills": "skills/",
  "extensions": "extensions/",
  "mcpServers": {
    "codegraph": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@colbymchenry/codegraph@1.6.2",
        "serve",
        "--mcp"
      ],
      "env": {
        "CODEGRAPH_TELEMETRY": "0"
      },
      "tools": [
        "*"
      ]
    }
  }
}
